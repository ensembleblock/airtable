{
  "name": "@ensembleblock/airtable",
  "description": "Lightweight Airtable API client powered by fetch",
  "keywords": [
    "airtable",
    "airtable-api",
    "api-client",
    "fetch",
    "typescript"
  ],
  "type": "module",
  "version": "0.0.11",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ensembleblock/airtable.git"
  },
  "homepage": "https://github.com/ensembleblock/airtable#readme",
  "bugs": {
    "url": "https://github.com/ensembleblock/airtable/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Eric L. Carraway",
    "url": "https://ensembleblock.com/"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "dist/index.d.ts",
  "main": "dist/index.js",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist node_modules",
    "clean:build": "rm -rf dist",
    "dev": "tsc --watch",
    "fix": "eslint --fix --quiet . ; prettier --write --log-level=silent .",
    "format": "prettier --check \"**/*.{cjs,js,md,ts}\"",
    "lint": "eslint src eslint.config.js",
    "prebuild": "npm run clean:build",
    "prepare": "npm run build",
    "prepublishOnly": "npm test",
    "pretest": "npm run build",
    "release": "np",
    "test": "npm run lint && npm run typecheck && vitest run",
    "test:dev": "npm run lint && npm run typecheck && vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@percuss.io/eslint-config-ericcarraway": "^9.0.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^18.5.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-sort-destructure-keys": "^3.0.0",
    "np": "^12.1.1",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1",
    "vitest-fetch-mock": "^0.3.0"
  }
}
